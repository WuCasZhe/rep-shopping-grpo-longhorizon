# ShopSimulator and OpenAI-compatible model services
SHOPSIM_BASE_URL=http://127.0.0.1:5700
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
SERVED_MODEL_NAME=shopping-agent

# Console logging is the default; optional SwanLab logging stays local.
SWANLAB_MODE=local

# DeepSeek V4.1 Flash: Teacher collection, Rubric Curator and Trajectory Judge.
# Set a private key in your shell or an untracked .env file before API requests.
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-flash
